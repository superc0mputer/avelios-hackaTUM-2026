OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-6-luna
# Optional: protect /v1/* with a bearer key (store the same value in the ElevenLabs agent)
# ENGINE_API_KEY=
# Optional: reasoning effort for reasoning-capable models (e.g. none, low, medium, high)
# OPENAI_REASONING_EFFORT=none
# Optional: override default mock case JSON path
# PATIENT_CASE_PATH=data/mock_gerhard_mueller.json
# Optional: ElevenLabs agent used for "Start conversation" in the teacher UI
# ELEVENLABS_AGENT_ID=
# Optional: OpenAI voice route (/ws/talk, "Voice: OpenAI" in the teacher UI)
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=   (default: ash for men, coral for women)
