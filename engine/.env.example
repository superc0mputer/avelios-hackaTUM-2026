OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-6-luna
# Protects /v1/* behind the public tunnel; store the same value as the ElevenLabs agent's
# custom-LLM API key. Required by demo.sh. Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_API_KEY=
# Optional: reasoning effort for reasoning-capable models (e.g. none, low, medium, high)
# OPENAI_REASONING_EFFORT=none
# Optional: override default mock case JSON path
# PATIENT_CASE_PATH=data/mock_gerhard_mueller.json
# ElevenLabs agent used for "Start conversation" in the teacher UI (required by demo.sh)
ELEVENLABS_AGENT_ID=
# ElevenLabs API key, so demo.sh can point the agent at the new tunnel on every start
ELEVENLABS_API_KEY=
# Optional: let testers outside your network open the teacher page and the live patient video
# through the tunnel with this code (demo.sh prints the link). Leave empty to keep it private.
PUBLIC_ACCESS_CODE=
