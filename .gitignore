# logs
*.log

# Unreal content: generated by unreal/build.sh (MetaHuman assets) or added from Fab (office props).
# Epic and Fab assets must never be published, so nothing under Content/ is tracked.
unreal/VIPPatient/Content/
# written by the editor on first launch
unreal/VIPPatient/Config/DefaultInput.ini

# Windows app download built by app/make_windows_app.ps1 (contains Epic assets)
dist/

# Office Pack from Fab (GLB download, see README): everyone downloads it from their own Fab library (licence: no redistribution)
unreal/OfficePack/
